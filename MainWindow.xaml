<Window x:Class="ByodKioskBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="BYOD 競賽防弊瀏覽器"
        WindowStyle="None"
        WindowState="Maximized"
        ResizeMode="NoResize"
        Topmost="True"
        Background="#1E1E1E"
        UseLayoutRounding="True">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 頂部狀態列 -->
        <Border Grid.Row="0" Background="#2D2D30" Height="34">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="BYOD 競賽防弊模式"
                           Foreground="#DDDDDD"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"
                           Margin="12,0,0,0" />

                <TextBlock Grid.Column="1"
                           x:Name="StatusText"
                           Text="正在初始化安全環境…"
                           Foreground="#9CDCFE"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="失焦次數："
                               Foreground="#DDDDDD"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="DeactivationCountText"
                               Text="0"
                               Foreground="#F48771"
                               FontWeight="Bold"
                               MinWidth="24"
                               TextAlignment="Right"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 主內容：左 評測網站 / 右 本地 Monaco 編輯器 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="360" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="2*" MinWidth="320" />
            </Grid.ColumnDefinitions>

            <wv2:WebView2 x:Name="JudgeWebView" Grid.Column="0" />

            <GridSplitter Grid.Column="1"
                          Width="4"
                          HorizontalAlignment="Stretch"
                          VerticalAlignment="Stretch"
                          Background="#3E3E42" />

            <wv2:WebView2 x:Name="EditorWebView" Grid.Column="2" />
        </Grid>

        <!-- 失焦防弊警示遮罩：預設隱藏，Window.Deactivated 時顯示 -->
        <Grid x:Name="WarningOverlay"
              Grid.RowSpan="2"
              Visibility="Collapsed"
              Background="#CC7A0000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚠ 偵測到視窗失去焦點"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="請立即返回本應用程式。切換至其他程式的行為已被記錄。"
                           Foreground="#FFECEC"
                           FontSize="18"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
                <TextBlock x:Name="OverlayCountText"
                           Foreground="#FFD5D5"
                           FontSize="16"
                           Margin="0,24,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
