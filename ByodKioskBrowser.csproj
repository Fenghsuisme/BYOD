<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- 依 CLAUDE.md 指定 .NET 8.0；WPF 需在 Windows 上建置 -->
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <RootNamespace>ByodKioskBrowser</RootNamespace>
    <AssemblyName>ByodKioskBrowser</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <!--
      非 Windows 平台（如 macOS）允許還原 Windows 參考組件以進行「編譯檢查」。
      注意：僅能編譯，無法在 macOS 執行 WPF/WebView2；實際執行請用 Windows。
      在 Windows 上 OS=Windows_NT，此屬性不會生效，建置行為維持原樣。
    -->
    <EnableWindowsTargeting Condition="'$(OS)' != 'Windows_NT'">true</EnableWindowsTargeting>
    <!-- 自包含單一執行檔發佈設定（於 dotnet publish 指定 RID 時生效） -->
    <SelfContained Condition="'$(PublishSingleFile)' == 'true'">true</SelfContained>
    <IncludeNativeLibrariesForSelfExtract Condition="'$(PublishSingleFile)' == 'true'">true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.2903.40" />
  </ItemGroup>

  <!--
    Monaco / 本地網頁靜態資源。
    複製到輸出目錄後，執行期以 SetVirtualHostNameToFolderMapping 掛載至 appassets.local，
    確保「嚴禁外連 CDN」。
  -->
  <ItemGroup>
    <Content Include="Assets\**\*.*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

</Project>
