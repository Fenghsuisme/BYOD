<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ByodKioskBrowser.MainWindow"
        Title="BYOD 競賽防弊瀏覽器"
        Background="#1E1E1E">

    <Panel>
        <!-- 主體：狀態列 + 左右分割 -->
        <Grid RowDefinitions="34,*">

            <!-- 頂部狀態列 -->
            <Border Grid.Row="0" Background="#2D2D30">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                    <TextBlock Grid.Column="0"
                               Text="BYOD 競賽防弊模式"
                               FontWeight="SemiBold"
                               Foreground="#DDDDDD"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="StatusText"
                               Text="正在初始化安全環境…"
                               Foreground="#9CDCFE"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <Button Grid.Column="2"
                            x:Name="EndExamButton"
                            Content="結束考試"
                            Padding="14,3"
                            VerticalAlignment="Center"
                            Background="#A1260D"
                            Foreground="White"
                            FontWeight="SemiBold" />
                </Grid>
            </Border>

            <!-- 左 評測網站 / 右 本地 Monaco 編輯器 -->
            <Grid Grid.Row="1" ColumnDefinitions="3*,4,2*">
                <Border Grid.Column="0" x:Name="JudgeHost" />
                <GridSplitter Grid.Column="1" Background="#3E3E42" />
                <Border Grid.Column="2" x:Name="EditorHost" />
            </Grid>
        </Grid>

        <!-- 失焦防弊警示遮罩：預設隱藏 -->
        <Border x:Name="WarningOverlay"
                IsVisible="False"
                Background="#CC7A0000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚠ 偵測到視窗失去焦點"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="請立即返回本應用程式。切換至其他程式的行為已被記錄。"
                           Foreground="#FFECEC"
                           FontSize="18"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

        <!-- 結束考試確認遮罩：預設隱藏 -->
        <Border x:Name="ConfirmOverlay"
                IsVisible="False"
                Background="#CC000000">
            <Border Background="#2D2D30"
                    CornerRadius="8"
                    Padding="32"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="確定要結束考試並繳交嗎？"
                               Foreground="White"
                               FontSize="22"
                               FontWeight="Bold"
                               HorizontalAlignment="Center" />
                    <TextBlock x:Name="ConfirmDetailText"
                               Text="將儲存所有分頁檔案與紀錄，之後關閉程式。"
                               Foreground="#CCCCCC"
                               FontSize="14"
                               Margin="0,12,0,0"
                               HorizontalAlignment="Center" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center"
                                Margin="0,24,0,0">
                        <Button x:Name="ConfirmYesButton"
                                Content="確定繳交"
                                Padding="18,6"
                                Margin="0,0,12,0"
                                Background="#A1260D"
                                Foreground="White" />
                        <Button x:Name="ConfirmNoButton"
                                Content="取消"
                                Padding="18,6"
                                Background="#3A3D41"
                                Foreground="White" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</Window>
