<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ByodKioskBrowser.MainWindow"
        Title="BYOD 競賽防弊瀏覽器"
        Background="#1E1E1E">

    <Panel>
        <!-- 主體：狀態列 + 左右分割 -->
        <Grid RowDefinitions="34,*">

            <!-- 頂部狀態列 -->
            <Border Grid.Row="0" Background="#2D2D30">
                <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0">
                    <TextBlock Grid.Column="0"
                               Text="BYOD 競賽防弊模式"
                               FontWeight="SemiBold"
                               Foreground="#DDDDDD"
                               VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1"
                               x:Name="StatusText"
                               Text="正在初始化安全環境…"
                               Foreground="#9CDCFE"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal"
                                VerticalAlignment="Center" Spacing="8">
                        <!-- 確認列放在頂部狀態列：置中遮罩會被 CEF 原生視窗蓋住 -->
                        <StackPanel x:Name="ConfirmPanel" IsVisible="False"
                                    Orientation="Horizontal" Spacing="8">
                            <TextBlock x:Name="ConfirmDetailText"
                                       Text="將儲存作答（不會關閉畫面），確定？"
                                       Foreground="#FFD580"
                                       VerticalAlignment="Center" />
                            <Button x:Name="ConfirmYesButton"
                                    Content="確定"
                                    Padding="14,3"
                                    Background="#A1260D"
                                    Foreground="White" />
                            <Button x:Name="ConfirmNoButton"
                                    Content="取消"
                                    Padding="14,3"
                                    Background="#3A3D41"
                                    Foreground="White" />
                        </StackPanel>
                        <Button x:Name="EndExamButton"
                                Content="結束考試"
                                Padding="14,3"
                                Background="#A1260D"
                                Foreground="White"
                                FontWeight="SemiBold" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 左 評測網站 / 右 本地 Monaco 編輯器 -->
            <Grid Grid.Row="1" ColumnDefinitions="3*,6,2*">
                <!-- 左：導覽列 + 評測網站 -->
                <Grid Grid.Column="0" RowDefinitions="32,*">
                    <Border Grid.Row="0" Background="#252526"
                            BorderBrush="#3E3E42" BorderThickness="0,0,0,1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center"
                                    Margin="6,0" Spacing="4">
                            <Button x:Name="BackButton" Content="◀ 返回" Padding="8,2" />
                            <Button x:Name="ForwardButton" Content="前進 ▶" Padding="8,2" />
                            <Button x:Name="ReloadButton" Content="⟳ 重新整理" Padding="8,2" />
                            <Button x:Name="HomeButton" Content="⌂ 首頁" Padding="8,2" />
                            <Button x:Name="LibraryButton" Content="[函式庫]" Padding="8,2" />
                            <Button x:Name="DictButton" Content="[英漢字典]" Padding="8,2" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Row="1" x:Name="JudgeHost" />
                </Grid>

                <GridSplitter Grid.Column="1" Background="#3E3E42" />
                <Border Grid.Column="2" x:Name="EditorHost" />
            </Grid>
        </Grid>

        <!-- 失焦防弊警示遮罩：預設隱藏 -->
        <Border x:Name="WarningOverlay"
                IsVisible="False"
                Background="#CC7A0000">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="⚠ 偵測到視窗失去焦點"
                           Foreground="White"
                           FontSize="34"
                           FontWeight="Bold"
                           HorizontalAlignment="Center" />
                <TextBlock Text="請立即返回本應用程式。切換至其他程式的行為已被記錄。"
                           Foreground="#FFECEC"
                           FontSize="18"
                           Margin="0,16,0,0"
                           HorizontalAlignment="Center" />
            </StackPanel>
        </Border>

    </Panel>
</Window>
